generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//enums garantem a consisitencia dos dados

//define os niveis de acesso ao sistema (ADMIN, ALUNO, PROF, PSI, PAIS)
enum Role {
  ADMIN
  ALUNO
  PROFESSOR
  PSICOLOGO
  PAIS
}

//genero biologico para calculos de percentis (M, F)
enum Sex {
  M
  F
}

//tipos de questionarios suportados
enum QuestionnaireType {
  AUTOCONCEITO
  AUTOESTIMA
  KIDMED
}

//classificacao dos resultados
enum QuestionnaireClassification {
  OPTIMAL
  AVERAGE
  VERY_LOW
}

//representa qualquer pessoa com acesso à plataforma
//armazena o passwordhasg em vez da palavra-passe em texto limpo
//inclui campos de consentimento(consentRgpd, consentShare) para conformidade legal
//um utilizador pode ser criador de varios registos(alunos, sessoes, auditorias)
//ou estar diretamente ligado a um perfil de aluno
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String   @map("password_hash")
  role         Role
  consentRgpd  Boolean  @default(false) @map("consent_rgpd")
  consentShare Boolean  @default(false) @map("consent_share")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  linkedStudent    Student?            @relation("LinkedStudentUser")
  createdStudents  Student[]           @relation("StudentCreator")
  recordedKidmedConsents Student[]     @relation("KidmedConsentRecorder")
  guardianLinks    StudentGuardian[]   @relation("Guardian")
  createdGuardians StudentGuardian[]   @relation("GuardianCreator")
  createdSessions  EvaluationSession[]
  resolvedAlerts   SosAlert[]          @relation("Resolver")
  createdReports   Report[]
  createdExemptions Exemption[]
  auditLogs        AuditLog[]

  @@map("users")
}


//nucleo da aplicacao. Contem a informacao demografica e eescolar
//O campo opcional linkedUserId permite que um aluno tenha as suas próprias credenciais de acesso
//Consentimento Kidmed:Rastreia quem registou o consentimento para o questionário de dieta mediterrânica
//Armazena o ano e a turma atual para facilitar a filtragem
model Student {
  id           String    @id @default(cuid())
  linkedUserId String?   @unique @map("linked_user_id")
  createdById  String?   @map("created_by")
  kidmedConsentRecordedById String? @map("kidmed_consent_recorded_by")
  processNumber String?  @unique @map("process_number")
  name         String
  sex          Sex
  birthDate    DateTime? @map("birth_date") @db.Date
  age          Int?      @db.SmallInt
  schoolYear   String?   @map("school_year")
  className    String?   @map("class_name")
  kidmedConsentAt DateTime? @map("kidmed_consent_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  linkedUser     User?              @relation("LinkedStudentUser", fields: [linkedUserId], references: [id], onDelete: SetNull)
  createdBy      User?              @relation("StudentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  kidmedConsentRecordedBy User?     @relation("KidmedConsentRecorder", fields: [kidmedConsentRecordedById], references: [id], onDelete: SetNull)
  biometrics     Biometric[]
  tests          Test[]
  questionnaires Questionnaire[]
  sosAlerts      SosAlert[]
  reports        Report[]
  exemptions      Exemption[]
  guardians      StudentGuardian[]
  sessions       EvaluationSession[]

  @@index([linkedUserId])
  @@index([createdById])
  @@index([kidmedConsentRecordedById])
  @@index([schoolYear])
  @@map("students")
}

model AcademicYear {
  id    String @id @default(cuid())
  label String @unique

  classes SchoolClass[]

  @@map("academic_years")
}

model SchoolClass {
  id             String @id @default(cuid())
  academicYearId String @map("academic_year_id")
  name           String

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, name])
  @@map("school_classes")
}


//Agrupa um conjunto de testes realizados num determinado momento (ex: "1º Período"). 
//Serve como contentor para biometria e testes físicos.
model EvaluationSession {
  id          String   @id @default(cuid())
  studentId   String   @map("student_id")
  label       String   @default("Avaliacao")
  schoolYear  String?  @map("school_year")
  createdById String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdBy  User?       @relation(fields: [createdById], references: [id])
  biometrics Biometric[]
  tests      Test[]

  @@map("evaluation_sessions")
}

//Armazena medições físicas como altura, peso, gordura e perímetro abdominal.
//Inclui o campo imc e as respetivas zonas de saúde (imcZone, fatZone, waistZone)
// para análise imediata.
model Biometric {
  id         String   @id @default(cuid())
  studentId  String   @map("student_id")
  sessionId  String?  @map("session_id")
  heightM    Decimal  @map("height_m") @db.Decimal(4, 2)
  weightKg   Decimal  @map("weight_kg") @db.Decimal(5, 2)
  fatPct     Decimal? @map("fat_pct") @db.Decimal(4, 1)
  waistCm    Decimal? @map("waist_cm") @db.Decimal(5, 1)
  imc        Decimal  @db.Decimal(4, 1)
  imcZone    String   @map("imc_zone")
  fatZone    String?  @map("fat_zone")
  waistZone  String?  @map("waist_zone")
  recordedAt DateTime @default(now()) @map("recorded_at")

  student Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session EvaluationSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([studentId, recordedAt(sort: Desc)])
  @@index([studentId, sessionId])
  @@map("biometrics")
}

//Regista os resultados de provas específicas (ex: Vai-vem, Cooper).
//Utiliza valueNum para valores numéricos e valueText para formatos específicos (como tempos mm:ss).
model Test {
  id         String   @id @default(cuid())
  studentId  String   @map("student_id")
  sessionId  String?  @map("session_id")
  testId     String   @map("test_id")
  valueNum   Decimal? @map("value_num") @db.Decimal
  valueText  String   @map("value_text")
  unit       String
  zone       String
  recordedAt DateTime @default(now()) @map("recorded_at")

  student Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session EvaluationSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([studentId, recordedAt(sort: Desc)])
  @@index([studentId, sessionId])
  @@map("tests")
}


//Armazena respostas a instrumentos de avaliação psicológica ou nutricional.
//Utiliza um campo JSON (payload) para permitir diferentes estruturas de perguntas sem alterar o esquema da base de dados.
model Questionnaire {
  id            String            @id @default(cuid())
  studentId     String            @map("student_id")
  type          QuestionnaireType
  instrumentVersion String?       @map("instrument_version")
  schoolYear    String?           @map("school_year")
  periodKey     String?           @map("period_key")
  score         Int?
  classification QuestionnaireClassification?
  payload       Json
  deferredCount Int               @default(0) @map("deferred_count")
  submittedAt   DateTime          @default(now()) @map("submitted_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, submittedAt(sort: Desc)])
  @@unique([studentId, type, schoolYear, periodKey])
  @@map("questionnaires")
}


//Mecanismo de sinalização para alunos que necessitem de intervenção. Liga o aluno 
//ao psicólogo e ao professor, permitindo o rastreio da resolução do caso.
model SosAlert {
  id           String    @id @default(cuid())
  studentId    String    @map("student_id")
  psych        String
  teacher      String
  psychEmail   String?   @map("psych_email")
  teacherEmail String?   @map("teacher_email")
  createdAt    DateTime  @default(now()) @map("created_at")
  resolved     Boolean   @default(false)
  resolvedAt   DateTime? @map("resolved_at")
  resolvedById String?   @map("resolved_by")

  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  resolvedBy User?   @relation("Resolver", fields: [resolvedById], references: [id])

  @@index([studentId, resolved])
  @@map("sos_alerts")
}

model Report {
  id          String   @id @default(cuid())
  studentId   String   @map("student_id")
  title       String   @default("Relatorio HealthyTechAtlantico")
  emailedTo   String   @map("emailed_to")
  schoolYear  String?  @map("school_year")
  createdById String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdById], references: [id])

  @@index([studentId, createdAt(sort: Desc)])
  @@map("reports")
}

//Regista períodos em que o aluno está isento de atividade física, com 
//controlo de datas e existência de atestado médico.
model Exemption {
  id                 String   @id @default(cuid())
  studentId          String   @map("student_id")
  reason             String
  startDate          DateTime @map("start_date") @db.Date
  endDate            DateTime @map("end_date") @db.Date
  medicalCertificate Boolean  @default(false) @map("medical_certificate")
  createdAt          DateTime @default(now()) @map("created_at")
  createdById        String   @map("created_by")

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id])

  @@map("exemptions")
}


//Tabela de ligação (Many-to-Many) que associa utilizadores com o perfil 
//de PAIS aos seus respetivos educandos.
model StudentGuardian {
  id             String   @id @default(cuid())
  studentId      String   @map("student_id")
  guardianUserId String   @map("guardian_user_id")
  relationship   String   @default("encarregado")
  createdById    String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian  User    @relation("Guardian", fields: [guardianUserId], references: [id], onDelete: Cascade)
  createdBy User    @relation("GuardianCreator", fields: [createdById], references: [id])

  @@unique([studentId, guardianUserId])
  @@index([studentId])
  @@index([guardianUserId])
  @@map("student_guardians")
}

//Regista ações críticas no sistema (quem fez o quê, quando e a partir de que IP), 
//essencial para segurança e depuração.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  targetId  String?  @map("target_id")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([action])
  @@map("audit_log")
}
