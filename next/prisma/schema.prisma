generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Perfis de acesso usados pelo RBAC em src/lib/rbac.ts.
enum Role {
  ADMIN
  ALUNO
  PROFESSOR
  PSICOLOGO
  PAIS
}

enum Sex {
  M
  F
}

enum QuestionnaireType {
  AUTOCONCEITO
  AUTOESTIMA
  EMOCIONAL
  KIDMED
}

enum QuestionnaireClassification {
  OPTIMAL
  AVERAGE
  VERY_LOW
}

// Conta de autenticação. Pode representar staff, aluno ou encarregado.
// Quando o utilizador é aluno, pode estar ligado a um registo Student.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  emailVerified DateTime? @map("email_verified")
  name         String?
  passwordHash String   @map("password_hash")
  role         Role
  consentRgpd  Boolean  @default(false) @map("consent_rgpd")
  consentShare Boolean  @default(false) @map("consent_share")
  mustChangePassword Boolean @default(false) @map("must_change_password")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  linkedStudent    Student?            @relation("LinkedStudentUser")
  createdStudents  Student[]           @relation("StudentCreator")
  recordedKidmedConsents Student[]     @relation("KidmedConsentRecorder")
  guardianLinks    StudentGuardian[]   @relation("Guardian")
  createdGuardians StudentGuardian[]   @relation("GuardianCreator")
  createdSessions  EvaluationSession[]
  resolvedAlerts   SosAlert[]          @relation("Resolver")
  createdReports   Report[]
  createdExemptions Exemption[]
  auditLogs        AuditLog[]
  consentHistorySubject ConsentHistory[] @relation("ConsentSubjectUser")
  consentHistoryChanges ConsentHistory[] @relation("ConsentChangedBy")

  @@map("users")
}

// Registo escolar do aluno acompanhado pela plataforma.
// Centraliza relações com biometria, testes, questionários, SOS e relatórios.
model Student {
  id           String    @id @default(cuid())
  linkedUserId String?   @unique @map("linked_user_id")
  createdById  String?   @map("created_by")
  kidmedConsentRecordedById String? @map("kidmed_consent_recorded_by")
  processNumber String?  @unique @map("process_number")
  name         String
  sex          Sex
  birthDate    DateTime? @map("birth_date") @db.Date
  age          Int?      @db.SmallInt
  schoolYear   String?   @map("school_year")
  className    String?   @map("class_name")
  kidmedConsentAt DateTime? @map("kidmed_consent_at")
  archivedAt    DateTime? @map("archived_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  linkedUser     User?              @relation("LinkedStudentUser", fields: [linkedUserId], references: [id], onDelete: SetNull)
  createdBy      User?              @relation("StudentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  kidmedConsentRecordedBy User?     @relation("KidmedConsentRecorder", fields: [kidmedConsentRecordedById], references: [id], onDelete: SetNull)
  biometrics     Biometric[]
  tests          Test[]
  questionnaires Questionnaire[]
  sosAlerts      SosAlert[]
  reports        Report[]
  exemptions      Exemption[]
  guardians      StudentGuardian[]
  sessions       EvaluationSession[]
  consentHistory ConsentHistory[]

  @@index([linkedUserId])
  @@index([createdById])
  @@index([kidmedConsentRecordedById])
  @@index([schoolYear])
  @@map("students")
}

// Ano letivo usado para agrupar turmas e relatórios.
model AcademicYear {
  id    String @id @default(cuid())
  label String @unique

  classes SchoolClass[]

  @@map("academic_years")
}

// Turma dentro de um ano letivo.
model SchoolClass {
  id             String @id @default(cuid())
  academicYearId String @map("academic_year_id")
  name           String

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, name])
  @@map("school_classes")
}

// Agrupa avaliações feitas na mesma sessão, por exemplo biometria e testes.
model EvaluationSession {
  id          String   @id @default(cuid())
  studentId   String   @map("student_id")
  label       String   @default("Avaliacao")
  schoolYear  String?  @map("school_year")
  createdById String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  student    Student     @relation(fields: [studentId], references: [id])
  createdBy  User?       @relation(fields: [createdById], references: [id])
  biometrics Biometric[]
  tests      Test[]

  @@index([studentId])
  @@index([createdById])
  @@map("evaluation_sessions")
}

// Medições corporais e classificação por zonas.
model Biometric {
  id         String   @id @default(cuid())
  studentId  String   @map("student_id")
  sessionId  String?  @map("session_id")
  heightM    Decimal  @map("height_m") @db.Decimal(4, 2)
  weightKg   Decimal  @map("weight_kg") @db.Decimal(5, 2)
  fatPct     Decimal? @map("fat_pct") @db.Decimal(4, 1)
  waistCm    Decimal? @map("waist_cm") @db.Decimal(5, 1)
  imc        Decimal  @db.Decimal(4, 1)
  imcZone    String   @map("imc_zone")
  fatZone    String?  @map("fat_zone")
  waistZone  String?  @map("waist_zone")
  notes      String?  @map("notes")
  recordedAt DateTime @default(now()) @map("recorded_at")

  student Student            @relation(fields: [studentId], references: [id])
  session EvaluationSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([studentId, recordedAt(sort: Desc)])
  @@index([studentId, sessionId])
  @@map("biometrics")
}

// Resultado de um teste físico individual.
model Test {
  id         String   @id @default(cuid())
  studentId  String   @map("student_id")
  sessionId  String?  @map("session_id")
  testId     String   @map("test_id")
  valueNum   Decimal? @map("value_num") @db.Decimal
  valueText  String   @map("value_text")
  unit       String
  zone       String
  recordedAt DateTime @default(now()) @map("recorded_at")

  student Student            @relation(fields: [studentId], references: [id])
  session EvaluationSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([studentId, recordedAt(sort: Desc)])
  @@index([studentId, sessionId])
  @@map("tests")
}

// Respostas submetidas pelos alunos. O payload fica em JSON para suportar
// instrumentos diferentes sem criar uma tabela por questionário.
model Questionnaire {
  id            String            @id @default(cuid())
  studentId     String            @map("student_id")
  type          QuestionnaireType
  instrumentVersion String?       @map("instrument_version")
  schoolYear    String?           @map("school_year")
  periodKey     String?           @map("period_key")
  score         Int?
  classification QuestionnaireClassification?
  // Legacy (pré-encriptação). Mantido para compatibilidade/migração.
  payload       Json?
  // Payload cifrado at-rest (AES-256-GCM) via `src/lib/encryption.ts`
  payloadEncrypted String?        @map("payload_encrypted")
  deferredCount Int               @default(0) @map("deferred_count")
  submittedAt   DateTime          @default(now()) @map("submitted_at")

  student Student @relation(fields: [studentId], references: [id])

  @@index([studentId, submittedAt(sort: Desc)])
  @@unique([studentId, type, schoolYear, periodKey])
  @@map("questionnaires")
}

// Pedido de acompanhamento criado por um aluno e resolvido por staff.
model SosAlert {
  id           String    @id @default(cuid())
  studentId    String    @map("student_id")
  psych        String
  teacher      String
  psychEmail   String?   @map("psych_email")
  teacherEmail String?   @map("teacher_email")
  createdAt    DateTime  @default(now()) @map("created_at")
  resolved     Boolean   @default(false)
  resolvedAt   DateTime? @map("resolved_at")
  resolvedById String?   @map("resolved_by")

  student    Student @relation(fields: [studentId], references: [id])
  resolvedBy User?   @relation("Resolver", fields: [resolvedById], references: [id])

  @@index([studentId, resolved])
  @@index([resolvedById])
  @@index([createdAt])
  @@map("sos_alerts")
}

// Histórico de relatórios enviados por email.
model Report {
  id          String   @id @default(cuid())
  studentId   String   @map("student_id")
  title       String   @default("Relatorio HealthyTechAtlantico")
  emailedTo   String   @map("emailed_to")
  schoolYear  String?  @map("school_year")
  createdById String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  student   Student @relation(fields: [studentId], references: [id])
  createdBy User?   @relation(fields: [createdById], references: [id])

  @@index([studentId, createdAt(sort: Desc)])
  @@index([createdById])
  @@map("reports")
}

// Dispensa médica ou limitação temporária associada ao aluno.
model Exemption {
  id                 String   @id @default(cuid())
  studentId          String   @map("student_id")
  reason             String
  startDate          DateTime @map("start_date") @db.Date
  endDate            DateTime @map("end_date") @db.Date
  medicalCertificate Boolean  @default(false) @map("medical_certificate")
  createdAt          DateTime @default(now()) @map("created_at")
  createdById        String   @map("created_by")

  student   Student @relation(fields: [studentId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([studentId])
  @@index([createdById])
  @@index([startDate, endDate])
  @@map("exemptions")
}

// Associação entre um aluno e um encarregado de educação.
model StudentGuardian {
  id             String   @id @default(cuid())
  studentId      String   @map("student_id")
  guardianUserId String   @map("guardian_user_id")
  relationship   String   @default("encarregado")
  createdById    String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  student   Student @relation(fields: [studentId], references: [id])
  guardian  User    @relation("Guardian", fields: [guardianUserId], references: [id], onDelete: Cascade)
  createdBy User    @relation("GuardianCreator", fields: [createdById], references: [id])

  @@unique([studentId, guardianUserId])
  @@index([studentId])
  @@index([guardianUserId])
  @@map("student_guardians")
}

// Registo de ações relevantes para rastreabilidade e suporte.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  targetId  String?  @map("target_id")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([action])
  @@map("audit_log")
}

// Historico detalhado de alteracoes de consentimento RGPD/partilha.
model ConsentHistory {
  id               String   @id @default(cuid())
  subjectUserId    String?  @map("subject_user_id")
  subjectStudentId String?  @map("subject_student_id")
  changedById      String?  @map("changed_by")
  field            String
  previousValue    Boolean? @map("previous_value")
  nextValue        Boolean  @map("next_value")
  reason           String?
  ipAddress        String?  @map("ip_address")
  createdAt        DateTime @default(now()) @map("created_at")

  subjectUser    User?    @relation("ConsentSubjectUser", fields: [subjectUserId], references: [id], onDelete: Cascade)
  subjectStudent Student? @relation(fields: [subjectStudentId], references: [id], onDelete: Cascade)
  changedBy      User?    @relation("ConsentChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([subjectUserId, createdAt(sort: Desc)])
  @@index([subjectStudentId, createdAt(sort: Desc)])
  @@index([changedById])
  @@map("consent_history")
}

// Tokens usados em verificação de email e fluxos semelhantes.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
