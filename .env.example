# ─── Database (PostgreSQL / Supabase) ─────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Set to "require" for cloud databases with SSL (Supabase, Render, Railway, etc.)
PGSSLMODE=require

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# REQUIRED in production — server will refuse to start without this.
JWT_SECRET=CHANGE_ME_use_node_crypto_randomBytes_64_hex

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── CORS — set to your production domain ─────────────────────────────────────
ALLOWED_ORIGIN=https://atlanticofit.colegio.pt

# ─── Admin secret — used ONCE to create professor/psicologo accounts ──────────
# POST /api/auth/admin/create-staff  { secret, email, password, role }
# Remove or clear this variable after creating all staff accounts.
ADMIN_SECRET=CHANGE_ME_strong_random_secret

# ─── Microsoft 365 Email (SMTP) ───────────────────────────────────────────────
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=atlanticofit@colegio.pt
SMTP_FROM=AtlanticoFit <atlanticofit@colegio.pt>

# Option A: Basic authentication (app password)
SMTP_AUTH_TYPE=login
SMTP_PASS=your_m365_app_password

# Option B: OAuth2 / Modern Auth (recommended for M365)
# SMTP_AUTH_TYPE=oauth2
# SMTP_CLIENT_ID=
# SMTP_CLIENT_SECRET=
# SMTP_REFRESH_TOKEN=
