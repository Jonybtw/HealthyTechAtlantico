# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres.dddhfzesmtagfgzzecrt:fgfQnixeU19wxNHi@aws-1-eu-central-1.pooler.supabase.com:6543/postgres
# Set to "require" if using a cloud database with SSL (e.g. Supabase, Render)
PGSSLMODE=require

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=AtF9x2kPqr8mZvLw3YnTbDsEcJhUfNg5iRl6CeByVuOdWtMpKjHqZs7AmX4oRn1

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000

# ─── Microsoft 365 Email (SMTP) ───────────────────────────────────────────────
# Host and port for Microsoft 365 / Exchange Online
SMTP_HOST=smtp.office365.com
SMTP_PORT=587

# The Microsoft 365 mailbox address used to send emails
SMTP_USER=atlanticofit@colegio.pt

# Display name + address shown in the "From" field
SMTP_FROM=AtlanticoFit <atlanticofit@colegio.pt>

# ── Option A: Basic Authentication (app password) ─────────────────────────────
# Use this if your M365 tenant allows basic SMTP AUTH.
# Go to: https://admin.microsoft.com → Users → your user → Mail → Manage email apps
# → enable "Authenticated SMTP". Then use the account password or an app password.
SMTP_AUTH_TYPE=login
SMTP_PASS=your_m365_account_password

# ── Option B: OAuth2 / Modern Authentication (recommended) ────────────────────
# 1. Register an app in Azure Active Directory (Entra ID):
#    https://portal.azure.com → App registrations → New registration
# 2. Add API permission: Microsoft Graph → Mail.Send (Delegated or Application)
# 3. Create a client secret and copy it below.
# 4. Grant admin consent.
# 5. Obtain a refresh token (e.g. using Postman OAuth2 flow with
#    https://login.microsoftonline.com/<TENANT_ID>/oauth2/v2.0/token).
#
# SMTP_AUTH_TYPE=oauth2
# SMTP_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# SMTP_CLIENT_SECRET=your_azure_client_secret
# SMTP_REFRESH_TOKEN=your_refresh_token
# SMTP_ACCESS_TOKEN=          # leave empty — nodemailer refreshes automatically